{
  "name": "nmr-figure-editor",
  "private": true,
  "version": "0.1.0",
  "description": "JEOL Delta (.jdf) のNMRスペクトルを重ね書き・注釈して資料用の図にするブラウザアプリ",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && node scripts/clean-dist.mjs && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc",
    "tokens": "node design/tokens.mjs",
    "pack": "npm run build && node scripts/pack.mjs"
  },
  "dependencies": {
    "events": "^3.3.0",
    "immer": "^11.1.18",
    "jeolconverter": "^1.0.4",
    "ketcher-core": "^3.18.0",
    "ketcher-react": "^3.18.0",
    "ketcher-standalone": "^3.18.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
